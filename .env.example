# Copy to ~/.config/odds-scanner/.env (outside the repo) and fill in.
# Only ODDS_API_KEY is required; the exchange keys only enable placing orders.

# https://the-odds-api.com (the only source that costs credits)
ODDS_API_KEY=

# Kalshi: Account > API keys. Keep the .pem outside the repo.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/absolute/path/to/kalshi-private-key.pem

# Polymarket US: polymarket.us/developer, after verifying in their iOS app.
# Not polymarket.com.
POLYMARKET_KEY_ID=
POLYMARKET_SECRET_KEY=
